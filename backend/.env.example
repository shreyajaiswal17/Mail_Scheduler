PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://reachinbox:reachinbox_dev@localhost:5433/reachinbox?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Authentication
JWT_SECRET="replace_with_a_long_random_secret"
FRONTEND_URL="http://localhost:5173"

# Ethereal SMTP
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your_ethereal_user"
SMTP_PASSWORD="your_ethereal_password"
SMTP_ENCRYPTION_KEY="your_64_character_hex_encryption_key"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Bull Board
ADMIN_EMAILS="your_google_email@example.com"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="mail-scheduler-emails"