generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
  NEEDS_REVIEW
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  campaigns       EmailCampaign[]
  slackConnection SlackConnection?
}

model Sender {
  id              String   @id @default(uuid())
  userId          String
  email           String
  name            String?
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPasswordEnc String?  @db.Text
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id])
  emails    EmailJob[]
  campaigns EmailCampaign[]

  @@unique([userId, email])
}

model EmailCampaign {
  id             String   @id @default(uuid())
  userId         String
  senderId       String
  idempotencyKey String?
  payloadHash    String?
  subject        String
  body           String   @db.Text
  startTime      DateTime
  delayMs        Int
  hourlyLimit    Int
  createdAt      DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id])
  sender Sender     @relation(fields: [senderId], references: [id])
  emails EmailJob[]

  @@unique([userId, idempotencyKey])
}

model EmailJob {
  id                   String      @id @default(uuid())
  campaignId           String
  senderId             String
  recipientEmail       String
  subject              String
  body                 String      @db.Text
  scheduledAt          DateTime
  nextEligibleAt       DateTime?
  sentAt               DateTime?
  status               EmailStatus @default(SCHEDULED)
  bullmqJobId          String?     @unique
  attempts             Int         @default(0)
  messageId            String?
  errorMessage         String?     @db.Text
  claimToken           String?
  leaseExpiresAt       DateTime?
  smtpAttemptStartedAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id])
  sender   Sender        @relation(fields: [senderId], references: [id])

  @@index([status, scheduledAt])
  @@index([status, nextEligibleAt])
  @@index([status, leaseExpiresAt])
  @@index([senderId, scheduledAt])
}

model OutboxEvent {
  id         String       @id @default(uuid())
  eventType  String       @default("SEND_EMAIL")
  jobId      String       @unique
  payload    Json
  status     OutboxStatus @default(PENDING)
  retryCount Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  accessToken String   @db.Text
  channelId   String?
  connectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}